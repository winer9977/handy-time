*.log
*.log.old
store.json
store.json.*
backup/
archive/

# 诊断脚本的临时输出目录
.tmp/
shots/
shots-embedded/
# 截图脚本的落点：screenshots/ 里只留 README 用到的那几张定稿图
screenshots/live/
shot.png

# 编辑器 / 系统
.vscode/
.idea/
Thumbs.db
.DS_Store
